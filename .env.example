# ─── Application ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# ─── Paths ──────────────────────────────────────────────────────
# Everything under DATA_DIR is intended to be volume-mounted in Docker.
DATA_DIR=./data
SQLITE_PATH=./data/investa.sqlite
DUCKDB_PATH=./data/signals.duckdb
UNIVERSES_DIR=./data/universes

# ─── Scanner ────────────────────────────────────────────────────
DEFAULT_UNIVERSE=sp500                # sp500 | ndx100 | custom
DEFAULT_MODE=deep_reversal            # deep_reversal | pullback
DEFAULT_INTERVAL=1d                   # 1d | 1wk
MIN_SCORE_THRESHOLD=60.0
SCAN_BATCH_SIZE=50
SCAN_BATCH_DELAY_SECONDS=0.5
SCAN_LOOKBACK_DAYS=260                # >= 220 to satisfy EMA-200 warm-up

# ─── Scheduler (cron, worker process only) ──────────────────────
SCAN_CRON_PREMARKET=0 6 * * 1-5
SCAN_CRON_OPEN=30 9 * * 1-5
SCAN_CRON_CLOSE=5 16 * * 1-5
MARKET_CONTEXT_CRON=0 7 * * 1        # weekly Monday 07:00

# ─── Cache ──────────────────────────────────────────────────────
YF_CACHE_TTL_SECONDS=900              # 15 min OHLCV cache
TICKER_VALIDATION_TTL_SECONDS=86400   # 24h

# ─── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
